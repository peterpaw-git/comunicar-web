# URL del server Evolution GO (WhatsApp)
EVOLUTION_URL=http://IP_SERVER:8080

# TOKEN dell'istanza (non la chiave globale) — trovalo in /instance/all
EVOLUTION_APIKEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Se il backend è esposto pubblicamente (per inviare immagini via URL)
# Lascia vuoto se non serve o non hai un dominio pubblico
BACKEND_PUBLIC_URL=

# Porta del backend (default 3001)
PORT=3001

# Relay webhook: se impostato, ogni evento ricevuto viene anche forwardato a questo URL
# Usato per condividere il webhook con un'altra app (es. Supabase function)
# WEBHOOK_FORWARD_URL=https://xxxx.supabase.co/functions/v1/whatsapp-webhook
